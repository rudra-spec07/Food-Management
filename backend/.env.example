# Database Connection (Neon PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# JWT Configuration
JWT_SECRET="replace-with-a-long-secure-random-secret-key-at-least-32-chars"
JWT_EXPIRES_IN="1h"

# Application Configuration
NODE_ENV="development"
PORT=5000

# Rate Limiting Configuration
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_WINDOW_MS=3600000
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_CHANGE_PASSWORD_WINDOW_MS=900000
RATE_LIMIT_CHANGE_PASSWORD_MAX=5

# Development Seed Admin Credentials
DEV_ADMIN_EMAIL="admin@example.com"
DEV_ADMIN_PASSWORD="replace-with-a-secure-dev-password"

# Module 06 Notification Worker Configuration
OUTBOX_POLL_INTERVAL_MS=3000
OUTBOX_BATCH_SIZE=10
DELIVERY_POLL_INTERVAL_MS=5000
DELIVERY_BATCH_SIZE=10

# CORS Configuration
CORS_ORIGIN="http://localhost:5173"

# Global API Rate Limiting
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=300

# Cloudinary Integration Configuration
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
CLOUDINARY_FOLDER="foodshare_donations"
MAX_FILE_SIZE_MB=5