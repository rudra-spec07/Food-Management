generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  DONOR
  ADMIN
  WORKER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum AuditEventType {
  USER_REGISTERED
  USER_LOGIN_SUCCESS
  USER_LOGIN_FAILED
  USER_LOGOUT
  PASSWORD_CHANGED
  USER_DEACTIVATED
  USER_REACTIVATED
  DONATION_CREATED
  DONATION_UPDATED
  DONATION_CANCELLED
  DONATION_APPROVED
  DONATION_REJECTED
  DONATION_ASSIGNED
  ASSIGNMENT_ACCEPTED
  ASSIGNMENT_REJECTED
  WORKER_CREATED
  PICKUP_CREATED
  PICKUP_STARTED
  PICKUP_COMPLETED
  PICKUP_FAILED
  DONATION_COMPLETED
  INVENTORY_CREATED
  INVENTORY_INCREASED
  INVENTORY_RESERVED
  INVENTORY_RELEASED
  INVENTORY_DISTRIBUTED
  INVENTORY_ADJUSTED
}

enum InventoryStatus {
  AVAILABLE
  RESERVED
  DISTRIBUTED
  EXPIRED
  DISCARDED
}

enum MovementType {
  INFLOW
  OUTFLOW
  RESERVATION
  RELEASE
  EXPIRATION_DISCARD
  ADJUSTMENT
}

enum PickupStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

enum PickupEventType {
  PICKUP_CREATED
  PICKUP_STARTED
  PICKUP_COMPLETED
  PICKUP_FAILED
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum ReviewDecision {
  APPROVED
  REJECTED
}

enum DonationCategory {
  COOKED_MEAL
  PACKAGED_FOOD
  GROCERIES
  BAKERY
  FRUITS
  VEGETABLES
  OTHER
}

enum DonationQuantityUnit {
  PORTIONS
  KG
  LITERS
  PACKETS
  BOXES
  ITEMS
}

enum DonationStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  ASSIGNED
  ACCEPTED
  PICKED_UP
  COMPLETED
  CANCELLED
}

model User {
  id                   String                  @id @default(uuid()) @db.Uuid
  firstName            String                  @map("first_name") @db.VarChar(100)
  lastName             String                  @map("last_name") @db.VarChar(100)
  email                String                  @unique @map("email") @db.VarChar(255)
  phone                String?                 @map("phone") @db.VarChar(20)
  passwordHash         String                  @map("password_hash") @db.Text
  role                 UserRole                @default(DONOR) @map("role")
  status               UserStatus              @default(ACTIVE) @map("status")
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.Timestamptz
  lastLoginAt          DateTime?               @map("last_login_at") @db.Timestamptz

  authSessions         AuthSession[]
  auditLogs            AuditLog[]
  donations            Donation[]
  statusHistoryChanges DonationStatusHistory[]
  donationReviews      DonationReview[]
  workerAssignments    Assignment[]            @relation("WorkerAssignments")
  adminAssignments     Assignment[]            @relation("AdminAssignments")
  workerPickups        Pickup[]                @relation("WorkerPickups")
  actorPickupEvents    PickupEvent[]           @relation("ActorPickupEvents")
  actorInventoryMovements InventoryMovement[]  @relation("ActorInventoryMovements")
  distributionRecords  DistributionRecord[]    @relation("UserDistributionRecords")

  @@map("users")
}

model AuthSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenJti   String    @unique @map("token_jti") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenJti])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model AuditLog {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String?        @map("user_id") @db.Uuid
  action     AuditEventType @map("action")
  entityType String         @map("entity_type") @db.VarChar(50)
  entityId   String?        @map("entity_id") @db.VarChar(255)
  metadata   Json?          @map("metadata")
  ipAddress  String?        @map("ip_address") @db.VarChar(45)
  userAgent  String?        @map("user_agent") @db.Text
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz

  user       User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model Donation {
  id              String                @id @default(uuid()) @db.Uuid
  donorId         String                @map("donor_id") @db.Uuid
  category        DonationCategory      @map("category")
  description     String                @map("description") @db.Text
  quantity        Decimal               @map("quantity") @db.Decimal(10, 2)
  quantityUnit    DonationQuantityUnit  @map("quantity_unit")
  preparedAt      DateTime              @map("prepared_at") @db.Timestamptz
  expiresAt       DateTime              @map("expires_at") @db.Timestamptz
  pickupAddress   String                @map("pickup_address") @db.Text
  pickupLatitude  Decimal?              @map("pickup_latitude") @db.Decimal(9, 6)
  pickupLongitude Decimal?              @map("pickup_longitude") @db.Decimal(9, 6)
  contactName     String                @map("contact_name") @db.VarChar(100)
  contactPhone    String                @map("contact_phone") @db.VarChar(20)
  photoUrl        String?               @map("photo_url") @db.VarChar(500)
  notes           String?               @map("notes") @db.Text
  status          DonationStatus        @default(PENDING_REVIEW) @map("status")
  rejectionReason String?               @map("rejection_reason") @db.Text
  cancelledAt     DateTime?             @map("cancelled_at") @db.Timestamptz
  completedAt     DateTime?             @map("completed_at") @db.Timestamptz
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  donor           User                  @relation(fields: [donorId], references: [id], onDelete: Restrict)
  statusHistory   DonationStatusHistory[]
  review          DonationReview?
  assignments     Assignment[]
  pickups         Pickup[]
  inventoryItem   InventoryItem?

  @@index([donorId])
  @@index([status])
  @@index([createdAt])
  @@index([expiresAt])
  @@index([donorId, createdAt])
  @@index([status, expiresAt])
  @@map("donations")
}

model DonationStatusHistory {
  id         String          @id @default(uuid()) @db.Uuid
  donationId String          @map("donation_id") @db.Uuid
  fromStatus DonationStatus? @map("from_status")
  toStatus   DonationStatus  @map("to_status")
  changedBy  String          @map("changed_by") @db.Uuid
  changedAt  DateTime        @default(now()) @map("changed_at") @db.Timestamptz
  reason     String?         @map("reason") @db.Text

  donation   Donation        @relation(fields: [donationId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [changedBy], references: [id], onDelete: Restrict)

  @@index([donationId])
  @@index([changedBy])
  @@map("donation_status_history")
}

model DonationReview {
  id         String         @id @default(uuid()) @db.Uuid
  donationId String         @unique @map("donation_id") @db.Uuid
  reviewerId String         @map("reviewer_id") @db.Uuid
  decision   ReviewDecision @map("decision")
  reason     String?        @map("reason") @db.Text
  reviewedAt DateTime       @default(now()) @map("reviewed_at") @db.Timestamptz
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz

  donation   Donation       @relation(fields: [donationId], references: [id], onDelete: Cascade)
  reviewer   User           @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([reviewerId])
  @@index([reviewedAt])
  @@map("donation_reviews")
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  aggregateType String    @map("aggregate_type") @db.VarChar(50)
  aggregateId   String    @map("aggregate_id") @db.VarChar(255)
  eventType     String    @map("event_type") @db.VarChar(100)
  payload       Json      @map("payload")
  retryCount    Int       @default(0) @map("retry_count")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  publishedAt   DateTime? @map("published_at") @db.Timestamptz

  @@index([createdAt])
  @@map("outbox_events")
}

model Assignment {
  id              String           @id @default(uuid()) @db.Uuid
  donationId      String           @map("donation_id") @db.Uuid
  workerId        String           @map("worker_id") @db.Uuid
  assignedBy      String           @map("assigned_by") @db.Uuid
  status          AssignmentStatus @default(PENDING) @map("status")
  rejectionReason String?          @map("rejection_reason") @db.Text
  assignedAt      DateTime         @default(now()) @map("assigned_at") @db.Timestamptz
  respondedAt     DateTime?        @map("responded_at") @db.Timestamptz
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  donation        Donation         @relation(fields: [donationId], references: [id], onDelete: Restrict)
  worker          User             @relation("WorkerAssignments", fields: [workerId], references: [id], onDelete: Restrict)
  assigner        User             @relation("AdminAssignments", fields: [assignedBy], references: [id], onDelete: Restrict)
  pickup          Pickup?

  @@index([workerId])
  @@index([donationId])
  @@index([status])
  @@index([workerId, status])
  @@index([donationId, createdAt(sort: Desc)])
  @@map("assignments")
}

model Pickup {
  id              String         @id @default(uuid()) @db.Uuid
  donationId      String         @map("donation_id") @db.Uuid
  assignmentId    String         @unique @map("assignment_id") @db.Uuid
  workerId        String         @map("worker_id") @db.Uuid
  status          PickupStatus   @default(NOT_STARTED) @map("status")
  startedAt       DateTime?      @map("started_at") @db.Timestamptz
  completedAt     DateTime?      @map("completed_at") @db.Timestamptz
  failedAt        DateTime?      @map("failed_at") @db.Timestamptz
  failureReason   String?        @map("failure_reason") @db.Text
  completionNotes String?        @map("completion_notes") @db.Text
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  donation        Donation       @relation(fields: [donationId], references: [id], onDelete: Restrict)
  assignment      Assignment     @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  worker          User           @relation("WorkerPickups", fields: [workerId], references: [id], onDelete: Restrict)
  events          PickupEvent[]
  inventoryItem   InventoryItem?

  @@index([workerId])
  @@index([status])
  @@index([workerId, status])
  @@index([donationId])
  @@index([createdAt(sort: Desc)])
  @@map("pickups")
}

model PickupEvent {
  id         String          @id @default(uuid()) @db.Uuid
  pickupId   String          @map("pickup_id") @db.Uuid
  eventType  PickupEventType @map("event_type")
  actorId    String          @map("actor_id") @db.Uuid
  actorRole  UserRole        @map("actor_role")
  fromStatus PickupStatus?   @map("from_status")
  toStatus   PickupStatus    @map("to_status")
  notes      String?         @map("notes") @db.Text
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz

  pickup     Pickup          @relation(fields: [pickupId], references: [id], onDelete: Cascade)
  actor      User            @relation("ActorPickupEvents", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([pickupId])
  @@index([createdAt])
  @@map("pickup_events")
}

model InventoryItem {
  id                  String               @id @default(uuid()) @db.Uuid
  donationId          String               @unique @map("donation_id") @db.Uuid
  pickupId            String               @unique @map("pickup_id") @db.Uuid
  foodCategory        DonationCategory     @map("food_category")
  description         String               @map("description") @db.Text
  totalQuantity       Decimal              @map("total_quantity") @db.Decimal(10, 2)
  availableQuantity   Decimal              @map("available_quantity") @db.Decimal(10, 2)
  reservedQuantity    Decimal              @default(0) @map("reserved_quantity") @db.Decimal(10, 2)
  distributedQuantity Decimal              @default(0) @map("distributed_quantity") @db.Decimal(10, 2)
  unit                DonationQuantityUnit @map("unit")
  status              InventoryStatus      @default(AVAILABLE) @map("status")
  location            String?              @map("location") @db.VarChar(255)
  expirationDate      DateTime?            @map("expiration_date") @db.Timestamptz
  receivedAt          DateTime             @default(now()) @map("received_at") @db.Timestamptz
  donorReference      String?              @map("donor_reference") @db.VarChar(255)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  donation            Donation             @relation(fields: [donationId], references: [id], onDelete: Restrict)
  pickup              Pickup               @relation(fields: [pickupId], references: [id], onDelete: Restrict)
  movements           InventoryMovement[]
  distributionRecords DistributionRecord[]

  @@index([status])
  @@index([foodCategory])
  @@index([expirationDate])
  @@index([createdAt(sort: Desc)])
  @@map("inventory_items")
}

model InventoryMovement {
  id                         String               @id @default(uuid()) @db.Uuid
  inventoryId                String               @map("inventory_id") @db.Uuid
  movementType               MovementType         @map("movement_type")
  quantity                   Decimal              @map("quantity") @db.Decimal(10, 2)
  unit                       DonationQuantityUnit @map("unit")
  previousAvailableQuantity  Decimal              @map("previous_available_quantity") @db.Decimal(10, 2)
  resultingAvailableQuantity Decimal              @map("resulting_available_quantity") @db.Decimal(10, 2)
  referenceType              String?              @map("reference_type") @db.VarChar(50)
  referenceId                String?              @map("reference_id") @db.Uuid
  actorId                    String               @map("actor_id") @db.Uuid
  actorRole                  UserRole             @map("actor_role")
  notes                      String?              @map("notes") @db.Text
  createdAt                  DateTime             @default(now()) @map("created_at") @db.Timestamptz

  inventory                  InventoryItem        @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  actor                      User                 @relation("ActorInventoryMovements", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([inventoryId])
  @@index([createdAt(sort: Desc)])
  @@map("inventory_movements")
}

enum DistributionStatus {
  COMPLETED
}

model DistributionRecord {
  id            String               @id @default(uuid()) @db.Uuid
  inventoryId   String               @map("inventory_id") @db.Uuid
  distributedBy String               @map("distributed_by") @db.Uuid
  recipientName String               @map("recipient_name") @db.VarChar(255)
  quantity      Decimal              @map("quantity") @db.Decimal(10, 2)
  unit          DonationQuantityUnit @map("unit")
  status        DistributionStatus   @default(COMPLETED) @map("status")
  notes         String?              @map("notes") @db.Text
  distributedAt DateTime             @default(now()) @map("distributed_at") @db.Timestamptz
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  inventory     InventoryItem        @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  distributor   User                 @relation("UserDistributionRecords", fields: [distributedBy], references: [id], onDelete: Restrict)

  @@index([inventoryId])
  @@index([distributedBy])
  @@index([distributedAt(sort: Desc)])
  @@map("distribution_records")
}
