generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  DONOR
  ADMIN
  WORKER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum AuditEventType {
  USER_REGISTERED
  USER_LOGIN_SUCCESS
  USER_LOGIN_FAILED
  USER_LOGOUT
  PASSWORD_CHANGED
  USER_DEACTIVATED
  USER_REACTIVATED
  DONATION_CREATED
  DONATION_UPDATED
  DONATION_CANCELLED
  DONATION_APPROVED
  DONATION_REJECTED
}

enum ReviewDecision {
  APPROVED
  REJECTED
}

enum DonationCategory {
  COOKED_MEAL
  PACKAGED_FOOD
  GROCERIES
  BAKERY
  FRUITS
  VEGETABLES
  OTHER
}

enum DonationQuantityUnit {
  PORTIONS
  KG
  LITERS
  PACKETS
  BOXES
  ITEMS
}

enum DonationStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  ASSIGNED
  ACCEPTED
  PICKED_UP
  COMPLETED
  CANCELLED
}

model User {
  id                   String                  @id @default(uuid()) @db.Uuid
  firstName            String                  @map("first_name") @db.VarChar(100)
  lastName             String                  @map("last_name") @db.VarChar(100)
  email                String                  @unique @map("email") @db.VarChar(255)
  phone                String?                 @map("phone") @db.VarChar(20)
  passwordHash         String                  @map("password_hash") @db.Text
  role                 UserRole                @default(DONOR) @map("role")
  status               UserStatus              @default(ACTIVE) @map("status")
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.Timestamptz
  lastLoginAt          DateTime?               @map("last_login_at") @db.Timestamptz

  authSessions         AuthSession[]
  auditLogs            AuditLog[]
  donations            Donation[]
  statusHistoryChanges DonationStatusHistory[]
  donationReviews      DonationReview[]

  @@map("users")
}

model AuthSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenJti   String    @unique @map("token_jti") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenJti])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model AuditLog {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String?        @map("user_id") @db.Uuid
  action     AuditEventType @map("action")
  entityType String         @map("entity_type") @db.VarChar(50)
  entityId   String?        @map("entity_id") @db.VarChar(255)
  metadata   Json?          @map("metadata")
  ipAddress  String?        @map("ip_address") @db.VarChar(45)
  userAgent  String?        @map("user_agent") @db.Text
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz

  user       User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model Donation {
  id              String                @id @default(uuid()) @db.Uuid
  donorId         String                @map("donor_id") @db.Uuid
  category        DonationCategory      @map("category")
  description     String                @map("description") @db.Text
  quantity        Decimal               @map("quantity") @db.Decimal(10, 2)
  quantityUnit    DonationQuantityUnit  @map("quantity_unit")
  preparedAt      DateTime              @map("prepared_at") @db.Timestamptz
  expiresAt       DateTime              @map("expires_at") @db.Timestamptz
  pickupAddress   String                @map("pickup_address") @db.Text
  pickupLatitude  Decimal?              @map("pickup_latitude") @db.Decimal(9, 6)
  pickupLongitude Decimal?              @map("pickup_longitude") @db.Decimal(9, 6)
  contactName     String                @map("contact_name") @db.VarChar(100)
  contactPhone    String                @map("contact_phone") @db.VarChar(20)
  photoUrl        String?               @map("photo_url") @db.VarChar(500)
  notes           String?               @map("notes") @db.Text
  status          DonationStatus        @default(PENDING_REVIEW) @map("status")
  rejectionReason String?               @map("rejection_reason") @db.Text
  cancelledAt     DateTime?             @map("cancelled_at") @db.Timestamptz
  completedAt     DateTime?             @map("completed_at") @db.Timestamptz
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  donor           User                  @relation(fields: [donorId], references: [id], onDelete: Restrict)
  statusHistory   DonationStatusHistory[]
  review          DonationReview?

  @@index([donorId])
  @@index([status])
  @@index([createdAt])
  @@index([expiresAt])
  @@index([donorId, createdAt])
  @@index([status, expiresAt])
  @@map("donations")
}

model DonationStatusHistory {
  id         String          @id @default(uuid()) @db.Uuid
  donationId String          @map("donation_id") @db.Uuid
  fromStatus DonationStatus? @map("from_status")
  toStatus   DonationStatus  @map("to_status")
  changedBy  String          @map("changed_by") @db.Uuid
  changedAt  DateTime        @default(now()) @map("changed_at") @db.Timestamptz
  reason     String?         @map("reason") @db.Text

  donation   Donation        @relation(fields: [donationId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [changedBy], references: [id], onDelete: Restrict)

  @@index([donationId])
  @@index([changedBy])
  @@map("donation_status_history")
}

model DonationReview {
  id         String         @id @default(uuid()) @db.Uuid
  donationId String         @unique @map("donation_id") @db.Uuid
  reviewerId String         @map("reviewer_id") @db.Uuid
  decision   ReviewDecision @map("decision")
  reason     String?        @map("reason") @db.Text
  reviewedAt DateTime       @default(now()) @map("reviewed_at") @db.Timestamptz
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz

  donation   Donation       @relation(fields: [donationId], references: [id], onDelete: Cascade)
  reviewer   User           @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([reviewerId])
  @@index([reviewedAt])
  @@map("donation_reviews")
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  aggregateType String    @map("aggregate_type") @db.VarChar(50)
  aggregateId   String    @map("aggregate_id") @db.VarChar(255)
  eventType     String    @map("event_type") @db.VarChar(100)
  payload       Json      @map("payload")
  retryCount    Int       @default(0) @map("retry_count")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  publishedAt   DateTime? @map("published_at") @db.Timestamptz

  @@index([createdAt])
  @@map("outbox_events")
}
